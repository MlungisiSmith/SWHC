# Switch Health Check Configuration
# DO NOT COMMIT THIS FILE TO VERSION CONTROL
# Copy this to .env and fill in the values

# Switch Credentials
SWITCH_USERNAME=your_switch_username_here
SWITCH_PASSWORD=your_switch_password_here
