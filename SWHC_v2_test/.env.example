.env.example file for SWHC v2

# Switch Credentials
SWITCH_USERNAME=networks
SWITCH_PASSWORD=w00Lw0rTh$
SWITCH_ENABLE_SECRET=w00Lw0rTh$

# App Settings
APP_ENV=production
APP_DEBUG=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/swch.db

# Redis
REDIS_URL=redis://swhc-v2-redis:6379/0

# Security
SECRET_KEY=change-me-in-production-with-secure-random-key
ENCRYPTION_KEY=change-me-with-32-byte-encryption-key

# Monitoring
CHECK_INTERVAL_SECONDS=30
CONNECTION_TIMEOUT=15
